# App
NODE_ENV=development
PORT=3000
API_PREFIX=v1

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=thivien_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Redis (optional for caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Upload / Storage
UPLOAD_MAX_SIZE_MB=10
STORAGE_PROVIDER=local

# Anthropic Claude — dùng cho /v1/dictionary/lookup (tra cứu Hán–Việt)
# Để trống sẽ tự động fallback bộ dữ liệu offline có sẵn.
ANTHROPIC_API_KEY=
